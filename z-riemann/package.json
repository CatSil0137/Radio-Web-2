{
  "name": "z-riemann-visualizer",
  "version": "1.0.0",
  "private": true,
  "description": "Z Riemann Visualizer - Android app (Capacitor) built from zeta-riemann.html",
  "scripts": {
    "build": "node scripts/build-www.js",
    "sync": "node scripts/build-www.js && cap sync android",
    "icons": "capacitor-assets generate --android --iconBackgroundColor '#040c1e' --iconBackgroundColorDark '#040c1e' --splashBackgroundColor '#040c1e' --splashBackgroundColorDark '#040c1e'",
    "open": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0"
  }
}
